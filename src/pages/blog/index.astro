---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";

const posts = (await getCollection('blog')).sort(
    (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime(),
);
---
<style>

    ul {
        display: flex;
        flex-wrap: wrap;
        gap: 2rem;
        list-style-type: none;
        margin: 0;
        padding: 0;
    }
    ul li {
        width: calc(50% - 1rem);
    }
    ul li * {
        text-decoration: none;
        transition: 0.2s ease;
    }
    ul li:first-child {
        width: 100%;
        margin-bottom: 1rem;
        text-align: center;
    }
    ul li:first-child img {
        width: 100%;
    }
    ul li:first-child .title {
        font-size: 2.369rem;
    }
    ul li img {
        margin-bottom: 0.5rem;
        border-radius: 12px;
    }
    ul li a {
        display: block;
    }
    .title {
        margin: 0;
        line-height: 1;
        flex: 1; 
        text-align: left;
        font-size: 1.5rem;
        font-weight: bold;
    }
    .description {
        flex: 1;
        text-align: left;
        color:#BFC1C9;
    }
    .date {
        text-align: left;
    }
    ul li:hover {
        box-shadow: 0 4px 8px rgba(255, 255, 255, 0.8);
        transition: box-shadow 0.3s ease-in-out;
    }

    .post-text {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    @media (max-width: 720px) {
        ul {
            gap: 0.5em;
        }
        ul li {
            width: 100%;
            text-align: center;
        }
        ul li:first-child {
            margin-bottom: 0;
        }
        ul li:first-child .title {
            font-size: 1.563em;
        }

        .post-text {
            flex-direction: column;
            align-items: flex-start; 
        }

        .post-text .title {
            margin-bottom: 1rem; 
        }
        .post-text .description {
            margin-bottom: 1rem; 
        }
    }
</style>
<Layout>

    <main>
        <section>
            <ul>
                {
                    posts.map((post) => (
                        <li class="text-white border border-gray-200 shadow-sm sm:p-8 dark:bg-gray-800 dark:border-gray-700 mb-8">
                            <p class="date mb-3">
                                <time datetime={post.data.pubDate.toISOString()}>
                                    {
                                        post.data.pubDate.toLocaleDateString('es-MX', {
                                            year: 'numeric',
                                            month: 'long',
                                            day: 'numeric',
                                        })
                                    }
                                </time>
                            </p>
                            <a href={`/blog/${post.id}/`}>
                                {post.data.heroImage ? (

                                    <Image src={post.data.heroImage} alt="" class="rounded-lg shadow-md" width={720} height={360} />
                                ) : (
                                    <div class="post-text">
                                        <h1 class="title">{post.data.title}</h1>
                                        <p class="description">{post.data.description}</p>
                                    </div>
                                )}

                                {post.data.heroImage && (
                                    <div class="post-text">
                                        <h1 class="title">{post.data.title}</h1>
                                        <p class="description">{post.data.description}</p>
                                        
                                    </div>
                                )}
                            </a>
                            {post.data.tags && (
                                    <div>
                                        {post.data.tags.split(',').map(tag => (
                                            <span class="inline-flex items-center bg-indigo-100 text-indigo-800 text-xs font-medium px-2.5 py-0.5 rounded-full dark:bg-indigo-900 dark:text-indigo-300 mr-2" style="margin-bottom: 0.25rem;">
                                                {tag.trim()}
                                            </span>
                                        ))}
                                    </div>
                                )}
                        </li>
                    ))
                }
            </ul>
        </section>
    </main>
</Layout>