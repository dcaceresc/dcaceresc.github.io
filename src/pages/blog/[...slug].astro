---
import { type CollectionEntry, getCollection } from 'astro:content';
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);
---

<Layout>
	<section class="bg-white dark:bg-gray-800">
		<div class="prose dark:prose-invert py-8 px-4 mx-auto max-w-screen-xl text-center lg:py-16">
			<div class="w-full">

				{post.data.heroImage && (
					<Image src={post.data.heroImage} alt={post.data.title} class="w-full h-auto mb-4 rounded-t-lg" width={720} height={360} />
                ) }
				
				<!-- Título y fecha debajo de la imagen siempre -->
				<div class="w-full bg-gray-900 text-white text-left p-4 rounded-b-lg">
					<h1 class="text-xl font-bold">{post.data.title}</h1>
					<p class="text-sm">{new Date(post.data.pubDate).toLocaleDateString()}</p>
				</div>
			</div>

			<div style="text-align: left" class="mt-8">
				<Content />
			</div>
		</div>
	</section>
</Layout>
