---
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <div class="w-full p-4 bg-white border border-gray-200 shadow-sm sm:p-8 dark:bg-gray-800 dark:border-gray-700 mb-8">
        <h1 class="mb-5 text-3xl font-bold text-gray-900 dark:text-white">Habilidades técnicas</h1>
        <p class="mb-6 text-gray-600 dark:text-gray-300">Tecnologías de trabajo y proyectos relacionados. Los enlaces distinguen los proyectos en desarrollo; las demás herramientas se presentan sin un caso público asociado.</p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <section class="p-4 bg-gray-100 text-gray-700 rounded-lg shadow-sm dark:bg-gray-700 dark:text-gray-300">
                <h2 class="text-lg font-bold text-gray-900 dark:text-white">.NET (Framework/Core)</h2>
                <p class="mt-2">Desarrollo de aplicaciones con .NET.</p>
                <a href="/projects#fake-gundam-wiki-api" class="inline-block mt-2 text-blue-700 dark:text-blue-300 underline focus-visible:outline-2 focus-visible:outline-offset-4">FakeGundamWikiAPI — .NET 8</a>
            </section>
            <section class="p-4 bg-gray-100 text-gray-700 rounded-lg shadow-sm dark:bg-gray-700 dark:text-gray-300">
                <h2 class="text-lg font-bold text-gray-900 dark:text-white">SQL</h2>
                <p class="mt-2">Gestión de bases de datos con SQL Server, MySQL y PostgreSQL.</p>
                <a href="https://github.com/dcaceresc/sqlterm" class="inline-block mt-2 text-blue-700 dark:text-blue-300 underline focus-visible:outline-2 focus-visible:outline-offset-4">SQLTerm — Cliente SQL de terminal escrito en Go para SQL Server, MySQL y PostgreSQL.</a>
            </section>
            <section class="p-4 bg-gray-100 text-gray-700 rounded-lg shadow-sm dark:bg-gray-700 dark:text-gray-300">
                <h2 class="text-lg font-bold text-gray-900 dark:text-white">Angular</h2>
                <p class="mt-2">Desarrollo de interfaces web con Angular.</p>
                <a href="/projects#busca-tu-hobby" class="inline-block mt-2 text-blue-700 dark:text-blue-300 underline focus-visible:outline-2 focus-visible:outline-offset-4">BuscaTuHobby — En desarrollo</a>
            </section>
            <section class="p-4 bg-gray-100 text-gray-700 rounded-lg shadow-sm dark:bg-gray-700 dark:text-gray-300">
                <h2 class="text-lg font-bold text-gray-900 dark:text-white">Git</h2>
                <p class="mt-2">Control de versiones con GitHub y Bitbucket.</p>
            </section>
            <section class="p-4 bg-gray-100 text-gray-700 rounded-lg shadow-sm dark:bg-gray-700 dark:text-gray-300">
                <h2 class="text-lg font-bold text-gray-900 dark:text-white">Laravel</h2>
                <p class="mt-2">Desarrollo de aplicaciones web con Laravel.</p>
                <a href="/projects#deckhub" class="inline-block mt-2 text-blue-700 dark:text-blue-300 underline focus-visible:outline-2 focus-visible:outline-offset-4">DeckHub — En desarrollo</a>
            </section>
            <section class="p-4 bg-gray-100 text-gray-700 rounded-lg shadow-sm dark:bg-gray-700 dark:text-gray-300">
                <h2 class="text-lg font-bold text-gray-900 dark:text-white">JavaScript/TypeScript</h2>
                <p class="mt-2">Desarrollo web con JavaScript y TypeScript.</p>
            </section>
        </div>
    </div>
</Layout>
