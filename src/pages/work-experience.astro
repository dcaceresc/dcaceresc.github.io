---
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <section aria-labelledby="professional-experience" class="w-full p-4 bg-white border border-gray-200 shadow-sm sm:p-8 dark:bg-gray-800 dark:border-gray-700 mb-8">
        <h1 id="professional-experience" class="mb-5 text-3xl font-bold text-gray-900 dark:text-white">Experiencia profesional</h1>
        <ol class="relative text-gray-600 border-s border-gray-200 dark:border-gray-700 dark:text-gray-300">
            <li class="mb-8 ms-6">
                <h2 class="text-xl font-semibold text-gray-900 dark:text-white">Desarrollador de Software</h2>
                <p class="mt-2">Facultad de Economía y Negocios Universidad de Chile</p>
                <p class="text-sm">Octubre 2021 - Actualidad</p>
                <div class="p-4 mt-3 bg-gray-100 rounded-lg dark:bg-gray-700">
                    <ul class="list-disc pl-5 space-y-2 text-sm">
                        <li>Diseño y desarrollo de aplicaciones de gestión académica, con herramientas de seguimiento del rendimiento y aprendizaje en línea.</li>
                        <li>Mantención y actualización de los sistemas informáticos de la facultad.</li>
                        <li>Formación y apoyo a usuarios en el uso de las aplicaciones desarrolladas.</li>
                        <li>Participación en pruebas, identificación de problemas y resolución de errores.</li>
                    </ul>
                </div>
            </li>
            <li class="ms-6">
                <h2 class="text-xl font-semibold text-gray-900 dark:text-white">Analista Programador</h2>
                <p class="mt-2">Hospital Clínico Universidad de Chile</p>
                <p class="text-sm">Agosto 2015 - Septiembre 2021</p>
                <div class="p-4 mt-3 bg-gray-100 rounded-lg dark:bg-gray-700">
                    <ul class="list-disc pl-5 space-y-2 text-sm">
                        <li>Diseño y desarrollo de sistemas de información clínica para el acceso a registros médicos.</li>
                        <li>Implementación de soluciones de integración de datos entre sistemas y departamentos.</li>
                        <li>Desarrollo y mejora de funcionalidades en aplicaciones internas.</li>
                        <li>Soporte técnico y resolución de problemas en los sistemas implementados.</li>
                    </ul>
                </div>
            </li>
        </ol>
    </section>

    <section aria-labelledby="education" class="w-full p-4 bg-white border border-gray-200 shadow-sm sm:p-8 dark:bg-gray-800 dark:border-gray-700 mb-8">
        <h2 id="education" class="mb-5 text-2xl font-bold text-gray-900 dark:text-white">Educación</h2>
        <p class="text-gray-600 dark:text-gray-300">Universidad Católica del Maule</p>
        <p class="text-sm text-gray-600 dark:text-gray-300">Marzo 2008 - Diciembre 2015</p>
        <div class="p-4 mt-3 bg-gray-100 rounded-lg dark:bg-gray-700">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Ingeniero Civil Informático</h3>
            <a href="/Titulo.pdf" target="_blank" rel="noopener noreferrer" class="inline-block mt-2 text-blue-700 dark:text-blue-300 underline focus-visible:outline-2 focus-visible:outline-offset-4">Ver certificado</a>
        </div>
    </section>
</Layout>
